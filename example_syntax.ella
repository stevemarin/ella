# Ella syntax tour. docs/grammar.md is the reference; this file should always
# parse, and later run, without errors.

# Imports come first. A file is a module: `import geo.poly` would bind the
# path geo.poly (geo/poly.ella beside this file), and `as` gives it another
# name. These are standard library modules, whose names every module sees
# anyway, without their module's name (the prelude).
import lists
import maps.new_map as empty_map

# this is a comment

# Functions are lambdas bound with let: (params) -> ReturnType => body
# - functions take multiple arguments; there is no currying
# - type annotations are required for now; we can relax this later
# - indentation defines blocks
# - a let-bound lambda can call itself by name
# - the IR will support tail-call optimization (fibonacci and factorial below
#   are not tail calls, so they won't benefit)
let fibonacci = (n: i64) -> i64 =>
    # where must be the first clause in a function body. Its conditions are
    # checked at run time; conditions mentioning `return` (the result) are
    # checked on exit. fibonacci(-3) is a run-time error.
    where
        n >= 0
        return >= 0
    match n
      case 0 | 1
        1
      case _
        fibonacci(n - 1) + fibonacci(n - 2)

# assert is a keyword so failures can show the asserted source text
assert fibonacci(5) == 8

# another recursive example
let factorial = (n: i64) -> i64 =>
    where
        n >= 0
        return >= 0
    match n
        case 0 | 1 # this is also a comment, and the newline here is necessary
            1
        case _
            n * factorial(n - 1)

assert factorial(5) == 120

# Bindings are immutable unless marked mut, and evaluate to the bound value.
# Every target in a let chain is a new binding; mut applies to x only.
let y = mut x = z = 5
x += 1
print("x={{x}}, y={{y}}, z={{z}}") # prints: x=6, y=5, z=5
# y += 1   # compile error: y is immutable

# assignment (no let) requires an existing mut binding and returns the value
x = 10

# shadowing: a new let may reuse a name
let x = 4

# for loops; string interpolation takes any expression inside {{ }}
let names: [str] = ["bob", "steve", "jane"]
for name in names
    print("Hello, {{name}}!")
print("{{ len(names) }} names, first is {{ names[0] }}")

# ifs are expressions like everything
let iseven = (n: i64) -> bool => if n % 2 == 0 then true else false
assert iseven(4)

# both of these ifs are valid; else may start its own line
if x == 4 then
    print("x={{x}}")
else
    print("not 4")

if x == 4 then print("x={{x}}") else print("not 4")

# lambda expressions
# -> is for types, => is for computation
(x: i64) -> i64 => x + 2

# a two argument lambda; its type is (i64, i64) -> i64
(x: i64, y: i64) -> i64 => x + y

# a lambda passed to a function can leave out its types, which are inferred
assert ([1, 2] |> map(n => n * 10)) == [10, 20]

# no implicit type conversions: to_f64, to_i64 and parse_i64 are explicit
assert to_f64(3) / 2.0 == 1.5
assert parse_i64(trim(" 42 ")) == Ok(42)

# Result (Ok / Err) and Optional (Some / None) are built-in enums, and
# Error is a built-in struct holding a message, the error that caused it
# (if any), and where it was made
let invert = (n: f64) -> Result[f64, Error] =>
    if n == 0.0 then Err(Error("divide by zero")) else Ok(1.0 / n)

# match destructures enum variants, with optional guards and one-line arms;
# its cases must cover every value (a guarded case doesn't count)
let describe = (r: Result[f64, Error]) -> str =>
    match r
        case Ok(v) if v > 1.0 => "big"
        case Ok(_) => "small"
        case Err(e) => "error: {{e.message}}"
assert describe(invert(4.0)) == "small"

# ? propagates errors: Err(e)? returns Err(e) from the enclosing function
let double_inverse = (n: f64) -> Result[f64, Error] =>
    let v = invert(n)?
    Ok(v * 2.0)
assert double_inverse(0.0) == Err(Error("divide by zero"))

# An Error can wrap the one that caused it; == leaves out where each was made
let checked_inverse = (n: f64) -> Result[f64, Error] =>
    match invert(n)
        case Ok(v) => Ok(v)
        case Err(e) => Err(Error("can't invert {{n}}", e))
assert checked_inverse(0.0) == Err(Error("can't invert 0.0", Error("divide by zero")))

# / always returns f64; // floors to an integer and % matches it
assert 7 / 2 == 3.5
assert -7 // 2 == -4
assert -7 % 2 == 1
assert 2 ** 10 == 1024

# comparisons chain: 0 <= i < 10 means 0 <= i and i < 10
let i = 3
assert 0 <= i < 10
assert i in 0..10 and not (i in 0..3)
assert i not in [1, 2]

# ranges: 0..n excludes n, 0..=n includes it
let mut total = 0
for k in 0..=4
    total += k
assert total == 10

# pipes insert the left side as the first argument: xs |> f(a) is f(xs, a).
# a line can't end with an operator, so multi-line pipes need parentheses
let add = (a: i64, b: i64) -> i64 => a + b
let piped = (1
    |> add(2)
    |> add(3))
assert piped == 6

# indexing and assignment through a mut binding
let mut xs: [i64] = [1, 2, 3]
xs[0] = 7
assert xs[0] == 7 and len(xs) == 3

# a range as an index gives a slice; strings have split, join, find, ...
assert xs[1..3] == [2, 3]
assert "hello"[1..=2] == "el"
assert join(split("a,b,c", ","), "-") == "a-b-c"
assert find("hello", "ll") == Some(2)

# math and code points; library functions are values too
assert sqrt(16.0) == 4.0 and floor(-2.5) == -3.0
assert abs(-3) == 3 and min(2.5, 1.5) == 1.5 and max(1, 2) == 2
assert chr(ord("a") + 1) == "b"
let tidy: (str) -> str = trim
assert tidy("  x ") == "x"
assert round(2.5) == 3.0 and ceil(0.2) == 1.0 and cos(pi) == -1.0
assert upper("ab") == "AB" and starts_with("ella", "el")
assert pad_left("7", 3, "0") == "007" and format_f64(2.0 / 3.0, 2) == "0.67"

# the prelude has list functions written in Ella: map, filter, sort, reverse
let squares = [3, 1, 2] |> map((n: i64) -> i64 => n * n)
assert sort(squares) == [1, 4, 9] and reverse(squares) == [4, 1, 9]
assert filter(squares, (n: i64) -> bool => n > 3) == [9, 4]
let no_ages: Map[str, i64] = empty_map()
assert lists.sum(squares, 0) == 14 and len(no_ages) == 0

# tuples: items by position, or taken apart with a pattern in let
let pair = (1, "one")
let (number, name) = pair
assert pair.0 == number and pair.1 == name
let mut (low, high): (i64, i64) = (0, 10)
low += 1
let (mut step, limit) = (1, high)   # mut can mark one name of a pattern
step *= 2
assert step < limit

# values are copied: changing xs doesn't change ys
let ys = xs
xs += [4]
assert ys == [7, 2, 3]

# a mut parameter changes the caller's variable; the call marks it mut too
let push_twice = (mut list: [i64], x: i64) -> () =>
    list += [x, x]
push_twice(mut xs, 5)
assert xs == [7, 2, 3, 4, 5, 5]

# while, loop, and labeled break/continue
let mut count = 0
while count < 3
    count += 1

let grid: [[i64]] = [[1, 2], [0, 3], [-1, 4]]
# a label is a name and a colon before the loop
outer: for row in grid
    for cell in row
        if cell == 0 then continue outer
        if cell < 0 then break outer

# loop is an expression whose value comes from break
let mut n = 0
let found = loop
    n += 1
    if n * n > 50 then break n
assert found == 8

# strings use double or single quotes, which work the same way; the other
# kind of quote can appear inside without escaping
let greeting = 'say "hi" to {{names[0]}}'
let reply = "it's {{ len(greeting) }} characters"

# triple quotes make multi-line strings, which keep their content exactly
let poem = """roses are red
violets are blue"""
let verse = '''sugar is "sweet"
and so are you'''

# enums (provisional syntax)
enum Shape
    Circle(f64)
    Rect(f64, f64)
    Empty

let area = (s: Shape) -> f64 =>
    match s
        case Circle(r) => 3.14159 * r * r
        case Rect(w, h) => w * h
        case Empty => 0.0
assert area(Rect(2.0, 3.0)) == 6.0

# structs have named fields; generic types and functions take type parameters
struct Point
    x: f64
    y: f64
let mut corner = Point(1.0, 2.0)
corner.x = 3.0
assert corner.x + corner.y == 5.0

struct Pair[T]
    first: T
    second: T
let swap[T] = (p: Pair[T]) -> Pair[T] => Pair(p.second, p.first)
assert swap(Pair(1, 2)) == Pair(2, 1)

# a constraint says what a generic function does with its type parameter
let bigger[T: Ord] = (a: T, b: T) -> T => if a > b then a else b
assert bigger(2, 7) == 7 and bigger("b", "a") == "b"

# structs and enums can have methods, which take the value first; `add`,
# `compare` and the like give them operators, and `mut` marks a change
struct Vec2
    x: f64
    y: f64
    length2 = (v: Vec2) -> f64 => v.x * v.x + v.y * v.y
    add = (a: Vec2, b: Vec2) -> Vec2 => Vec2(a.x + b.x, a.y + b.y)
    compare = (a: Vec2, b: Vec2) -> i64 => if a.length2() < b.length2() then -1 else 1
    flip = (mut v: Vec2) -> () =>
        v = Vec2(v.y, v.x)
let mut arrow = Vec2(1.0, 0.0) + Vec2(0.0, 2.0)
mut arrow.flip()
assert arrow.length2() == 5.0 and arrow.x == 2.0
assert bigger(arrow, Vec2(1.0, 1.0)) == arrow   # Vec2 has compare, so it is Ord

# a user-defined constraint lists methods; any type that has them meets it
constraint Sized
    length2: (Self) -> f64
let longest[T: Sized] = (a: T, b: T) -> f64 =>
    if a.length2() > b.length2() then a.length2() else b.length2()
assert longest(Vec2(3.0, 4.0), arrow) == 25.0

# protocol methods: get and set give v[k], iter gives `for`, contains gives `in`
struct Row
    cells: [str]
    get = (r: Row, i: i64) -> str => r.cells[i]
    set = (mut r: Row, i: i64, s: str) -> () =>
        r.cells[i] = s
    iter = (r: Row) -> [str] => r.cells
    contains = (r: Row, s: str) -> bool => s in r.cells
let mut row = Row(["a", "b"])
row[1] = "c"
for cell in row
    assert cell in row and cell != "b"

# a function with yield is a generator: its body runs a step at a time,
# each time next (or a loop) asks for an item
let evens = (limit: i64) -> Gen[i64] =>
    let mut n = 0
    while n < limit
        yield n
        n += 2
let mut gen = evens(5)
assert next(mut gen) == Some(0)
for n in mut gen
    assert n == 2 or n == 4
assert next(mut gen) == None

# an iterator is a type with a next method, which `for` calls until None
struct Countdown
    n: i64
    next = (mut c: Countdown) -> Optional[i64] =>
        if c.n == 0 then return None
        c.n -= 1
        Some(c.n + 1)
for n in Countdown(3)
    assert n > 0

# a nocopy struct is never copied, and its finalizer runs when it dies
nocopy struct Session
    user: str
    finalize = (s: Session) -> () => print("goodbye {{s.user}}")

# a pool holds long-lived values; a handle to a freed value is caught
let mut points: Pool[Point] = pool_new()
let p = alloc(mut points, Point(0.0, 1.0))
points[p].y += 1.0
assert points[p].y == 2.0
free(mut points, p)

# an arena holds values of any types that are freed together, at once
let mut level: Arena = arena_new()
let start = alloc(mut level, Point(0.0, 0.0))
let title = alloc(mut level, "level 1")
level[title] += "!"
assert len(level) == 2 and level[start].x == 0.0
free(mut level)

# multi-stage programming: quote makes code, $ splices it in, and a splice
# outside any quote runs while compiling
let power = (n: i64, x: Code[i64]) -> Code[i64] =>
    if n == 0 then quote 1 else quote $x * $(power(n - 1, x))
let cube = (x: i64) -> i64 => $(power(3, quote x))   # compiles to x * (x * (x * 1))
assert cube(2) == 8

# types are values too, so code can be generated from a struct's fields:
# $t splices in a type, and v.$f a field
let sum_fields = (names: [str], v: Code[Point]) -> Code[f64] =>
    let mut total = quote 0.0
    for name in names
        total = quote $total + $v.$name
    total
let point_sum = $(quote (p: Point) -> f64 => $(sum_fields(fields(type Point), quote p)))
assert point_sum(Point(1.0, 2.0)) == 3.0

# functions can compute types while compiling, used with $ in a type
let Stack = (t: Type) -> Type => new_struct("Stack[{{type_name(t)}}]", ["items"], [type [$t]])
let numbers: $(Stack(type i64)) = $(Stack(type i64))([1, 2])
assert len(numbers.items) == 2

# print takes any number of values; eprint writes to standard error
print("low", low, "high", high)

# if main is defined, it runs after the top-level code (main can also be
# () -> i64, giving the program's exit status; exit(status) stops anywhere)
let main = () -> () =>
    print("done")
