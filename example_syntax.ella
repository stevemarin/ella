# Ella syntax tour. docs/grammar.md is the reference; this file should always
# parse, and later run, without errors.

# this is a comment

# Functions are lambdas bound with let: (params) -> ReturnType => body
# - functions take multiple arguments; there is no currying
# - type annotations are required for now; we can relax this later
# - indentation defines blocks
# - a let-bound lambda can call itself by name
# - the IR will support tail-call optimization (fibonacci and factorial below
#   are not tail calls, so they won't benefit)
let fibonacci = (n: i64) -> i64 =>
    # where must be the first clause in a function body. Its conditions are
    # checked at run time; conditions mentioning `return` (the result) are
    # checked on exit. fibonacci(-3) is a run-time error.
    where
        n >= 0
        return >= 0
    match n
      case 0 | 1
        1
      case _
        fibonacci(n - 1) + fibonacci(n - 2)

# assert is a keyword so failures can show the asserted source text
assert fibonacci(5) == 8

# another recursive example
let factorial = (n: i64) -> i64 =>
    where
        n >= 0
        return >= 0
    match n
        case 0 | 1 # this is also a comment, and the newline here is necessary
            1
        case _
            n * factorial(n - 1)

assert factorial(5) == 120

# Bindings are immutable unless marked mut, and evaluate to the bound value.
# Every target in a let chain is a new binding; mut applies to x only.
let y = mut x = z = 5
x += 1
print("x={{x}}, y={{y}}, z={{z}}") # prints: x=6, y=5, z=5
# y += 1   # compile error: y is immutable

# assignment (no let) requires an existing mut binding and returns the value
x = 10

# shadowing: a new let may reuse a name
let x = 4

# for loops; string interpolation takes any expression inside {{ }}
let names: [str] = ["bob", "steve", "jane"]
for name in names
    print("Hello, {{name}}!")
print("{{ len(names) }} names, first is {{ names[0] }}")

# ifs are expressions like everything
let iseven = (n: i64) -> bool => if n % 2 == 0 then true else false

# both of these ifs are valid; else may start its own line
if x == 4 then
    print("x={{x}}")
else
    print("not 4")

if x == 4 then print("x={{x}}") else print("not 4")

# lambda expressions
# -> is for types, => is for computation
(x: i64) -> i64 => x + 2

# a two argument lambda; its type is (i64, i64) -> i64
(x: i64, y: i64) -> i64 => x + y

# no implicit type conversions
# Result (Ok / Error) and Optional (Some / None) are built-in enums
let invert = (n: f64) -> Result[f64, Error] =>
    if n == 0.0 then Error("divide by zero") else Ok(1.0 / n)

# match destructures enum variants, with optional guards and one-line arms
let describe = (r: Result[f64, Error]) -> str =>
    match r
        case Ok(v) if v > 1.0 => "big"
        case Ok(v) => "small"
        case Error(e) => "error"

# ? propagates errors: Error(e)? returns Error(e) from the enclosing function
let double_inverse = (n: f64) -> Result[f64, Error] =>
    let v = invert(n)?
    Ok(v * 2.0)

# / always returns f64; // floors to an integer and % matches it
assert 7 / 2 == 3.5
assert -7 // 2 == -4
assert -7 % 2 == 1
assert 2 ** 10 == 1024

# comparisons chain: 0 <= i < 10 means 0 <= i and i < 10
let i = 3
assert 0 <= i < 10
assert i in 0..10 and not (i in 0..3)
assert i not in [1, 2]

# ranges: 0..n excludes n, 0..=n includes it
let mut total = 0
for k in 0..=4
    total += k
assert total == 10

# pipes insert the left side as the first argument: xs |> f(a) is f(xs, a).
# a line can't end with an operator, so multi-line pipes need parentheses
let add = (a: i64, b: i64) -> i64 => a + b
let piped = (1
    |> add(2)
    |> add(3))
assert piped == 6

# indexing and assignment through a mut binding
let mut xs: [i64] = [1, 2, 3]
xs[0] = 7
assert xs[0] == 7 and len(xs) == 3

# values are copied: changing xs doesn't change ys
let ys = xs
xs += [4]
assert ys == [7, 2, 3]

# a mut parameter changes the caller's variable; the call marks it mut too
let push_twice = (mut list: [i64], x: i64) -> () =>
    list += [x, x]
push_twice(mut xs, 5)
assert xs == [7, 2, 3, 4, 5, 5]

# while, loop, and labeled break/continue
let mut count = 0
while count < 3
    count += 1

let grid: [[i64]] = [[1, 2], [0, 3], [-1, 4]]
# a label is a name and a colon before the loop
outer: for row in grid
    for cell in row
        if cell == 0 then continue outer
        if cell < 0 then break outer

# loop is an expression whose value comes from break
let mut n = 0
let found = loop
    n += 1
    if n * n > 50 then break n
assert found == 8

# strings use double or single quotes, which work the same way; the other
# kind of quote can appear inside without escaping
let greeting = 'say "hi" to {{names[0]}}'
let reply = "it's {{ len(greeting) }} characters"

# triple quotes make multi-line strings, which keep their content exactly
let poem = """roses are red
violets are blue"""
let verse = '''sugar is "sweet"
and so are you'''

# enums (provisional syntax)
enum Shape
    Circle(f64)
    Rect(f64, f64)
    Empty

let area = (s: Shape) -> f64 =>
    match s
        case Circle(r) => 3.14159 * r * r
        case Rect(w, h) => w * h
        case Empty => 0.0

# structs have named fields; generic types and functions take type parameters
struct Point
    x: f64
    y: f64
let mut corner = Point(1.0, 2.0)
corner.x = 3.0
assert corner.x + corner.y == 5.0

struct Pair[T]
    first: T
    second: T
let swap[T] = (p: Pair[T]) -> Pair[T] => Pair(p.second, p.first)
assert swap(Pair(1, 2)) == Pair(2, 1)

# a nocopy struct is never copied, and its finalizer runs when it dies
nocopy struct Session
    user: str
    finalize = (s: Session) -> () => print("goodbye {{s.user}}")

# a pool holds long-lived values; a handle to a freed value is caught
let mut points: Pool[Point] = pool_new()
let p = alloc(mut points, Point(0.0, 1.0))
points[p].y += 1.0
assert points[p].y == 2.0
free(mut points, p)

# multi-stage programming: quote makes code, $ splices it in, and a splice
# outside any quote runs while compiling
let power = (n: i64, x: Code[i64]) -> Code[i64] =>
    if n == 0 then quote 1 else quote $x * $(power(n - 1, x))
let cube = (x: i64) -> i64 => $(power(3, quote x))   # compiles to x * (x * (x * 1))
assert cube(2) == 8

# types are values too, so code can be generated from a struct's fields:
# $t splices in a type, and v.$f a field
let sum_fields = (names: [str], v: Code[Point]) -> Code[f64] =>
    let mut total = quote 0.0
    for name in names
        total = quote $total + $v.$name
    total
let point_sum = $(quote (p: Point) -> f64 => $(sum_fields(fields(type Point), quote p)))
assert point_sum(Point(1.0, 2.0)) == 3.0

# functions can compute types while compiling, used with $ in a type
let Stack = (t: Type) -> Type => new_struct("Stack[{{type_name(t)}}]", ["items"], [type [$t]])
let numbers: $(Stack(type i64)) = $(Stack(type i64))([1, 2])
assert len(numbers.items) == 2

# if main is defined, it runs after the top-level code
let main = () -> () =>
    print("done")
