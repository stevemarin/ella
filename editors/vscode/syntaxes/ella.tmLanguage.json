{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ella",
  "scopeName": "source.ella",
  "fileTypes": ["ella"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#definition" },
        { "include": "#keyword" },
        { "include": "#number" },
        { "include": "#call" },
        { "include": "#type" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.ella",
      "captures": { "1": { "name": "punctuation.definition.comment.ella" } }
    },
    "string": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.ella",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ella" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.ella" } },
          "patterns": [{ "include": "#string-content" }]
        },
        {
          "begin": "'''",
          "end": "'''",
          "name": "string.quoted.triple.ella",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ella" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.ella" } },
          "patterns": [{ "include": "#string-content" }]
        },
        {
          "comment": "Single-line strings also end at the end of the line, where they are an error.",
          "begin": "\"",
          "end": "(\")|$",
          "name": "string.quoted.double.ella",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ella" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ella" } },
          "patterns": [{ "include": "#string-content" }]
        },
        {
          "begin": "'",
          "end": "(')|$",
          "name": "string.quoted.single.ella",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ella" } },
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.ella" } },
          "patterns": [{ "include": "#string-content" }]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "match": "\\\\(?:[\\\\\"'nrt0{]|x[0-7][0-9A-Fa-f]|u\\{[0-9A-Fa-f]{1,6}\\})",
          "name": "constant.character.escape.ella"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.ella"
        },
        {
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "name": "meta.interpolation.ella",
          "contentName": "source.ella",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.ella" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.ella" } },
          "patterns": [{ "include": "#code" }]
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "comment": "struct Point, enum Shape, constraint Ord",
          "match": "\\b(struct|enum|constraint)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.ella" },
            "2": { "name": "entity.name.type.ella" }
          }
        },
        {
          "comment": "let f = (x: i64) -> i64 => ..., and generic functions: let f[T] = ...",
          "match": "\\b(let)\\s+(?:(mut)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\[[^\\]]*\\])?\\s*=\\s*\\(.*\\)\\s*->)",
          "captures": {
            "1": { "name": "keyword.declaration.ella" },
            "2": { "name": "storage.modifier.ella" },
            "3": { "name": "entity.name.function.ella" }
          }
        },
        {
          "comment": "A method in a struct or enum: area = (s: Shape) -> f64 => ...",
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=\\s*\\(.*\\)\\s*->)",
          "captures": { "1": { "name": "entity.name.function.ella" } }
        },
        {
          "comment": "A loop label: outer: for ...",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?=\\s*(?:for|while|loop)\\b)",
          "captures": {
            "1": { "name": "entity.name.label.ella" },
            "2": { "name": "punctuation.separator.label.ella" }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(?:break|case|continue|else|for|if|in|loop|match|return|then|while|yield)\\b",
          "name": "keyword.control.ella"
        },
        {
          "match": "\\b(?:and|not|or)\\b",
          "name": "keyword.operator.logical.ella"
        },
        {
          "match": "\\b(?:false|true)\\b",
          "name": "constant.language.boolean.ella"
        },
        {
          "match": "\\b(?:constraint|enum|let|struct|type)\\b",
          "name": "keyword.declaration.ella"
        },
        {
          "match": "\\b(?:comptime|mut|nocopy)\\b",
          "name": "storage.modifier.ella"
        },
        {
          "match": "\\b(?:as|assert|import|quote|where)\\b",
          "name": "keyword.other.ella"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b",
          "name": "constant.numeric.integer.hexadecimal.ella"
        },
        {
          "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\b",
          "name": "constant.numeric.float.ella"
        },
        {
          "match": "\\b[0-9](?:_?[0-9])*\\b",
          "name": "constant.numeric.integer.decimal.ella"
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "match": "\\b(?:print|len|run|pool_new|arena_new|alloc|free|next|fields|field_type|has_field|type_name|type_kind|variants|new_struct|to_f64|to_f32|to_i64|to_i32|parse_i64|parse_f64|read_line|read_file|args|split|join|find|replace|trim|chars|ord|chr|sqrt|floor|abs|min|max|eprint|ceil|round|exp|ln|sin|cos|tan|asin|acos|atan|atan2|log10|log2|upper|lower|starts_with|ends_with|pad_left|pad_right|format_f64|env|write_file|exit|reverse|sort|map|filter|hash|sum|any|all|zip|enumerate|sort_by|range|new_map|fold|flatten|flat_map|position|new_set|set_of|first|last|index_of|unique|chunks|min_of|max_of|repeat|lines|words|trim_start|trim_end|strip_prefix|strip_suffix|split_once|count_of|is_digit|is_alpha|is_space|min_by|max_by|partition|map_of|group_by|counts|array|fill|reshape|shape|flat|total|dot|matmul|transpose)(?=\\s*\\()",
          "name": "support.function.builtin.ella"
        },
        {
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()",
          "name": "entity.name.function.call.ella"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "match": "\\b(?:i64|i32|f64|f32|bool|str)\\b",
          "name": "support.type.primitive.ella"
        },
        {
          "match": "\\b(?:Ok|Err|Some|None)\\b",
          "name": "support.constant.variant.ella"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.ella"
        }
      ]
    },
    "operator": {
      "patterns": [
        { "match": "->|=>", "name": "storage.type.function.arrow.ella" },
        { "match": "\\|>", "name": "keyword.operator.pipe.ella" },
        { "match": "\\.\\.=?", "name": "keyword.operator.range.ella" },
        { "match": "==|!=|<=|>=|<(?!<)|>(?!>)", "name": "keyword.operator.comparison.ella" },
        { "match": "(?://|[-+*/%])=", "name": "keyword.operator.assignment.compound.ella" },
        { "match": "\\*\\*|//|[-+*/%]", "name": "keyword.operator.arithmetic.ella" },
        { "match": "<<|>>|[&|^~]", "name": "keyword.operator.bitwise.ella" },
        { "match": "=", "name": "keyword.operator.assignment.ella" },
        { "match": "\\?", "name": "keyword.operator.error-propagation.ella" },
        { "match": "\\$", "name": "keyword.operator.splice.ella" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": ",", "name": "punctuation.separator.comma.ella" },
        { "match": ":", "name": "punctuation.separator.colon.ella" },
        { "match": "\\.", "name": "punctuation.accessor.ella" },
        { "match": "[(\\[]", "name": "punctuation.section.brackets.begin.ella" },
        { "match": "[)\\]]", "name": "punctuation.section.brackets.end.ella" },
        { "match": "[{};!@`\\t]", "name": "invalid.illegal.character.ella" }
      ]
    }
  }
}
