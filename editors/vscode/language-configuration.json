{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{{", "close": "}}", "notIn": ["comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:match|case|for|while|struct|enum|constraint)\\b(?!.*=>).*|.*(?:=>|\\bthen|\\belse|\\bloop|\\bwhere|\\bquote|\\$|[^=!<>]=))\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*else\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:return|break|continue)\\b.*$",
      "action": { "indent": "outdent" }
    }
  ]
}
