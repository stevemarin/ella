# Functions, recursion, closures, pipes, where clauses, and ?.

# top-level functions can call each other in any order
let is_even = (n: i64) -> bool => if n == 0 then true else is_odd(n - 1)
let is_odd = (n: i64) -> bool => if n == 0 then false else is_even(n - 1)
print(is_even(10))
print(is_odd(7))

let factorial = (n: i64) -> i64 =>
    where
        n >= 0
        return >= 1
    if n <= 1 then 1 else n * factorial(n - 1)
print(factorial(20))

# lambdas capture variables by copy, when they are created
let make_adder = (amount: i64) -> (i64) -> i64 =>
    (x: i64) -> i64 => x + amount
let add5 = make_adder(5)
print(add5(10))

let mut base = 1
let get_base = () -> i64 => base
base = 100
print(get_base())   # still sees the global's current value: globals aren't copied

let scale = () -> (i64) -> i64 =>
    let mut factor = 2
    let times = (x: i64) -> i64 => x * factor
    factor = 10
    times
print(scale()(3))   # 6: the local factor was copied when times was made

# a local function can call itself
let count_down = () -> [i64] =>
    let go = (n: i64) -> [i64] => if n == 0 then [0] else [n] + go(n - 1)
    go(3)
print(count_down())

# pipes pass the left side as the first argument
let add = (a: i64, b: i64) -> i64 => a + b
let double = (x: i64) -> i64 => x * 2
print(1 |> add(2) |> double)

# return exits early
let first_negative = (xs: [i64]) -> i64 =>
    for x in xs
        if x < 0 then return x
    0
print(first_negative([3, -4, -5]))
print(first_negative([1]))

# ? returns errors from the enclosing function
let parse_digit = (s: str) -> Result[i64, str] =>
    match s
        case "0" => Ok(0)
        case "1" => Ok(1)
        case "2" => Ok(2)
        case _ => Error("not a digit: {{s}}")
let add_digits = (a: str, b: str) -> Result[i64, str] =>
    Ok(parse_digit(a)? + parse_digit(b)?)
print(add_digits("1", "2"))
print(add_digits("1", "x"))

let main = () -> () =>
    print("main runs last")
