# An i64 overflow in arithmetic on arrays is the first item's (by position)
# that overflows, as for numbers, even though native code adds four at a time.
let grow = (a: Array[i64]) -> Array[i64] => a * 2 + a

let main = () -> () =>
    let mut a = array([1, 2, 3, 4, 5, 6])
    print(grow(a))
    a[2] = 3074457345618258603
    a[5] = 4611686018427387903
    print(grow(a))
