# The prelude: functions and a Map written in Ella (docs/grammar.md §10).

struct Money
    cents: i64
    add = (a: Money, b: Money) -> Money => Money(a.cents + b.cents)

struct Person
    name: str
    age: i64

let main = () -> () =>
    let xs = [3, 1, 2]
    print(sum(xs, 0), sum([0.5, 0.25], 0.0), sum(["a", "b", "c"], ""), sum([[1], [2, 3]], []))
    print(sum([Money(5), Money(7)], Money(0)), sum([], 10))
    print(any(xs, (n) => n > 2), all(xs, (n) => n > 2))
    print(any([], (_n: i64) -> bool => true), all([], (_n: i64) -> bool => false))
    # any and all stop as soon as they know.
    print(any(xs, (n) => n == 3 or n // 0 > 1))
    print(zip(xs, ["a", "b"]), zip([], xs), enumerate(["x", "y"]))
    print(range(0, 10, 3), range(10, 0, -4), range(5, 5, 1), range(0, -3, -1), range(3, 0, 1))
    let people = [Person("cy", 30), Person("al", 25), Person("bo", 30)]
    print(sort_by(people, (p) => p.age))
    print(sort_by(people, (p) => p.name))
    print(sort_by(["ccc", "a", "bb", "d"], len), sort_by([], (n: i64) -> i64 => n))
    print(reverse(xs), sort(xs), map(xs, (n) => n * n), filter(xs, (n) => n != 1))
    print(fold(xs, 10, (total, n) => total * n), fold([], "", (a: str, n: i64) -> str => a + "{{n}}"))
    print(fold(["a", "b"], [0], (acc, _s) => acc + [len(acc)]), flatten([[1], [], [2, 3]]), flatten([[[1]], [[2]]]))
    print(flat_map(xs, (n) => range(0, n, 1)), flat_map(["ab", "c"], chars), position(xs, (n) => n < 3))
    print(position(xs, (n) => n > 3), position([], (_n: i64) -> bool => true))
    let none: [i64] = []
    print(first(xs), last(xs), first(none), last(none), index_of(["a", "b", "a"], "a"), index_of(xs, 9))
    print(unique([3, 1, 3, 2, 1]), unique(none), unique([0.0, -0.0]), chunks([1, 2, 3, 4, 5], 2), chunks(none, 3))
    print(min_by(people, (p) => p.age), max_by(people, (p) => p.age), min_by(none, (n) => -n), max_by(["bb", "a", "cc"], len))
    print(partition(xs, (n) => n > 1), partition(none, (n) => n > 1))
    print(min_of(xs), max_of(["b", "c", "a"]), min_of(none), max_of([-1.5, 0.5]), min_of([2.0, nan]))

    # A Map keeps its keys in the order they were first set.
    let mut ages = new_map()
    ages["ann"] = 31
    ages["bob"] = 40
    ages["ann"] += 1
    print(ages["ann"], len(ages), "bob" in ages, "cy" in ages, "cy" not in ages)
    for name in ages
        print(name, ages[name])
    print(ages.lookup("cy"), ages.lookup("bob"))
    print(mut ages.remove("ann"), mut ages.remove("ann"), len(ages))
    ages["ann"] = 1
    print(ages.items(), ages.keys(), ages.values())

    # Any key with Eq will do; keys are told apart by ==, so 0.0 and -0.0 are one key, and NaN is never found.
    let mut grid: Map[(i64, i64), str] = new_map()
    grid[(0, 1)] = "a"
    grid[(1, 0)] = "b"
    print(grid[(1, 0)], (0, 0) in grid, len(grid))
    let mut floats = new_map()
    floats[0.0] = "zero"
    floats[-0.0] = "minus zero"
    print(len(floats), floats[0.0], floats.lookup(nan), 0.0 == -0.0)
    floats[nan] = "a"
    floats[nan] = "b"
    print(len(floats), nan in floats, floats.values())
    let mut errors = new_map()
    errors[Error("x", Error("y"))] = 1
    print(Error("x", Error("y")) in errors, Error("x") in errors)

    # Many keys, so it grows and puts them in new buckets several times.
    let mut squares: Map[i64, i64] = new_map()
    for i in 0..300
        squares[i] = i * i
    for i in 0..300
        if i % 3 == 0 then mut squares.remove(i)
    let mut total = 0
    for k in squares
        total += squares[k]
    print(len(squares), total, squares[298], squares.lookup(297), squares.keys()[0..5])

    # get_or, map_of, group_by and counts.
    print(ages.get_or("ann", 0), ages.get_or("zed", -1), map_of([("a", 1), ("b", 2), ("a", 3)]).items())
    print(group_by(["bb", "a", "ccc", "dd", "e"], len).items(), group_by(none, (n) => n).items())
    print(counts(chars("banana")).items(), counts([true, false, true])[true])

    # A Map is a value: a copy doesn't change with the original.
    let mut copy = ages
    copy["new"] = 0
    print(len(ages), len(copy), ages == copy)
    # hash works on any type with ==, and equal values hash the same, the same way in every backend.
    print(hash(""), hash("a"), hash("héllo"))
    print(hash(0), hash(1), hash(-1), hash(true), hash(()), hash(1.5), hash(-2.5e300))
    print(hash(0.0) == hash(-0.0), hash(nan) == hash(-nan), hash([1, 2]), hash([[1], []]), hash((1, "a")))
    print(hash(3..7), hash(5..1) == hash(9..2), hash(Some(3)), hash(None), hash(Ok(1)), hash(Money(5)))
    print(hash(Error("x")), hash(Error("x", Error("y"))), hash(Person("al", 25)), map([1, 2], hash))
    let mut pool = pool_new()
    let handle = alloc(mut pool, 5)
    let mut arena = arena_new()
    let ref = alloc(mut arena, "s")
    print(hash(handle), hash(ref))

    # A Set keeps its items in the order they were first inserted.
    let mut seen = new_set()
    print(mut seen.insert("b"), mut seen.insert("a"), mut seen.insert("b"), len(seen), "a" in seen, "c" not in seen)
    print(seen.items(), mut seen.remove("b"), mut seen.remove("b"), seen.items())
    let odd = set_of([1, 3, 5, 7, 3, 1])
    let small = set_of(range(0, 5, 1))
    print(odd.items(), odd.union(small).items(), small.union(odd).items())
    print(odd.intersection(small).items(), odd.difference(small).items(), small.difference(odd).items())
    print(set_of([3, 1]).is_subset(odd), odd.is_subset(small), new_set().is_subset(odd), len(set_of(["x"]).difference(set_of(["x"]))))
    let mut total_odd = 0
    for n in odd
        total_odd += n
    print(total_odd, set_of([(1, "a"), (1, "a"), (2, "a")]).items(), set_of([[1], [1], []]).items())
    # Sets are values too; == also compares their order.
    let mut more = odd
    mut more.insert(9)
    print(len(odd), len(more), odd == set_of([1, 3, 5, 7]), odd == set_of([7, 5, 3, 1]))

let nan = 0.0 / 0.0
