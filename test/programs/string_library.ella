# The standard library's strings module, part of the prelude (docs/grammar.md §10).

print(repeat("ab", 3), [repeat("x", 0), repeat("x", -2)], repeat("", 5) == "")

# lines leaves out the line breaks, \r\n too, and a line break at the end doesn't start a line.
print(lines("a\nb\r\n\nc"), lines("a\n"), lines(""), lines("\n"), lines("x\r"), lines("é\r\nü"))
print(words("  hello   big\tworld\n"), words(""), words("   "), words("one"), words("a\x0Bb\x0Cc"))
print([trim_start("  a b  "), trim_end("  a b  "), trim_end(""), trim_start(" \t "), trim_end("x\r\n")])
print([trim("  a b  "), trim("a b"), trim("    a b"), trim("a  b   ")])

print(strip_prefix("unhappy", "un"), strip_prefix("happy", "un"), strip_prefix("un", "un"), strip_prefix("a", ""))
print(strip_suffix("file.txt", ".txt"), strip_suffix("a", "ab"))
print(split_once("key=value=x", "="), split_once("novalue", "="), split_once("a::b", "::"), split_once("=", "="))
print(count_of("banana", "an"), count_of("aaaa", "aa"), count_of("", "a"), count_of("ééé", "é"))

print(is_digit("0129"), is_digit(""), is_digit("1a"), is_digit("-1"), is_digit("٣"))
print(is_alpha("Zebra"), is_alpha("a1"), is_alpha("é"), is_space(" \n\t"), is_space(" x"), is_space(""))

# Reading "key = value" lines.
let config = "name = ella\n# a comment\n\nstage=7  \n"
for line in lines(config)
    if line == "" or starts_with(line, "#") then continue
    match split_once(line, "=")
        case Some((key, value)) => print("{{trim(key)}}: {{trim(value)}}")
        case None => print("bad line: {{line}}")

# split_once needs a separator.
print(split_once("a", ""))
