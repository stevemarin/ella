# Lazy functions on anything a loop can go through. iters is part of the
# prelude, except its map, filter, zip and enumerate, whose names the eager
# ones of lists have: those are iters.map and so on.
import iters

let main = () -> () =>
    let odd_squares = count(1, 1) |> iters.map((n) => n * n) |> iters.filter((n) => n % 2 == 1) |> take(4)
    print(collect(odd_squares))

    # Advanced in place, a generator carries on where it stopped.
    let mut rest = take(count(1, 1), 5)
    print(next(mut rest))
    print(rest.collect())

    print(iters.zip(["a", "b", "c"], count(0.5, 0.25)) |> iters.enumerate() |> collect)
    print(chain([1, 2], [3]) |> scan(0, (a, x) => a + x) |> skip(1) |> collect)
    for n in [3, 1, 4, 1, 5] |> take_while((n) => n < 5)
        print(n)

    # Nothing runs until it is asked for.
    let loud = (n: i64) -> i64 =>
        print("computing", n)
        n * 10
    let mut lazy = count(1, 1) |> iters.map(loud)
    print("made")
    print(next(mut lazy))
    print(next(mut lazy))

    # The eager ones go through generators too, if they end.
    print(count(1, 1) |> take(3) |> map((n) => n * 2), each("ab") |> collect)

    print(iters.sum([1, 2, 3]))
    