# The lazy list functions of the iters module, on generators.
import iters

let main = () -> () =>
    let mut odd_squares = (
        iters.count(1, 1)
            |> iters.map((n) => n * n)
            |> iters.filter((n) => n % 2 == 1)
            |> iters.take(4)
    )
    print(iters.collect(mut odd_squares))
    print(next(mut odd_squares))

    let mut pairs = iters.zip(iters.each(["a", "b", "c"]), iters.count(0.5, 0.25)) |> iters.enumerate()
    print(iters.collect(mut pairs))

    let mut sums = iters.chain(iters.each([1, 2]), iters.each([3])) |> iters.scan(0, (a, x) => a + x) |> iters.skip(1)
    print(iters.collect(mut sums))

    for n in iters.each([3, 1, 4, 1, 5]) |> iters.take_while((n) => n < 5)
        print(n)

    # Nothing runs until it is asked for.
    let loud = (n: i64) -> i64 =>
        print("computing", n)
        n * 10
    let mut lazy = iters.count(1, 1) |> iters.map(loud)
    print("made")
    print(next(mut lazy))
    print(next(mut lazy))
