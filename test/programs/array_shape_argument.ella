# An argument whose shape the checker can't know is checked when the function is called.
let trace[; N] = (m: Array[f64; N, N]) -> f64 =>
    let mut sum = 0.0
    for i in 0..N
        sum += m[i, i]
    sum

let main = () -> () =>
    print(trace(fill([2, 2], 1.5)))
    print(trace(fill([2, 3], 1.5)))
