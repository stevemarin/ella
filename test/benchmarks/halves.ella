# Divide and conquer on list slices: each call looks at the two halves of
# its list, which used to be copied at every level.
let total = (xs: [i64]) -> i64 =>
    let n = len(xs)
    if n <= 8 then
        let mut sum = 0
        for x in xs
            sum += x
        sum
    else
        total(xs[0..n // 2]) + total(xs[n // 2..n])

let largest = (xs: [i64]) -> i64 =>
    let n = len(xs)
    if n == 1 then
        xs[0]
    else
        max(largest(xs[0..n // 2]), largest(xs[n // 2..n]))

let mut xs: [i64] = []
let mut seed = 12345
for _ in 0..100000
    seed = (seed * 1103515245 + 12345) % 2147483648
    xs += [seed % 1000000]
let mut sum = 0
let mut top = 0
for _ in 0..10
    sum += total(xs)
    top = max(top, largest(xs))
print(sum, top)
