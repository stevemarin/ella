# Merge sort from the standard library: each pass builds a new list.
let mut xs: [i64] = []
let mut seed = 12345
for _ in 0..200000
    seed = (seed * 1103515245 + 12345) % 2147483648
    xs += [seed % 1000000]
let sorted = sort(xs)
print(len(sorted))
print(sorted[0], sorted[100000], sorted[199999])
