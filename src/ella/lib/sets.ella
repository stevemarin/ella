# Sets of values. Part of the prelude: every module sees these names.

# A set of values, which keeps them in the order they were first inserted.
# It is a Map from its items to nothing, so items are told apart as a Map's
# keys are: by `==`, through `hash`.
struct Set[T: Eq]
    _map: Map[T, ()]
    contains = (s: Set[T], item: T) -> bool => item in s._map
    len = (s: Set[T]) -> i64 => len(s._map)
    iter = (s: Set[T]) -> [T] => s._map.keys()
    items = (s: Set[T]) -> [T] => s._map.keys()
    is_empty = (s: Set[T]) -> bool => len(s._map) == 0
    # Sets are equal when they have the same items, in any order, so their hash doesn't depend on it.
    eq = (s: Set[T], t: Set[T]) -> bool => len(s._map) == len(t._map) and s.is_subset(t)
    hash = (s: Set[T]) -> i64 =>
        let mut h = len(s._map)
        for item in s._map.keys()
            h = h ^ hash(item)
        h
    # A Set prints as its literal is written: {1, 2, 3}, or {/} if it is empty.
    text = (s: Set[T]) -> str =>
        if len(s._map) == 0 then return "{/}"
        let text = "{{s._map.keys()}}"
        "{" + text[1..len(text) - 1] + "}"
    # Adds an item, giving whether it is new.
    insert = (mut s: Set[T], item: T) -> bool =>
        if item in s._map then return false
        s._map[item] = ()
        true
    # Adds each item of a list, giving how many were new.
    insert_all = (mut s: Set[T], items: [T]) -> i64 =>
        let mut added = 0
        for item in items
            if mut s.insert(item) then added += 1
        added
    # Takes an item out, giving whether it was there.
    remove = (mut s: Set[T], item: T) -> bool =>
        if item not in s._map then return false
        mut s._map.remove(item)
        true
    # The items of either set: those of s, then the new ones of t.
    union = (s: Set[T], t: Set[T]) -> Set[T] =>
        let mut result = s
        for item in t
            mut result.insert(item)
        result
    # The items of s that are also in t.
    intersection = (s: Set[T], t: Set[T]) -> Set[T] =>
        let mut result = new_set()
        for item in s
            if item in t then mut result.insert(item)
        result
    # The items of s that aren't in t.
    difference = (s: Set[T], t: Set[T]) -> Set[T] =>
        let mut result = new_set()
        for item in s
            if item not in t then mut result.insert(item)
        result
    # Whether every item of s is in t.
    is_subset = (s: Set[T], t: Set[T]) -> bool =>
        for item in s
            if item not in t then return false
        true

let new_set[T: Eq] = () -> Set[T] => Set(new_map())

# The items of a list, each once, in the order they first appear.
let set_of[T: Eq] = (xs: [T]) -> Set[T] =>
    let mut result = new_set()
    for x in xs
        mut result.insert(x)
    result

# The items of a list, each once, in the order they first appear.
let unique[T: Eq] = (xs: [T]) -> [T] => set_of(xs).items()
