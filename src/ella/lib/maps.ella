# Maps from keys to values. Part of the prelude: every module sees these names.

# A map from keys to values, which keeps its keys in the order they were
# first set. Keys are told apart by their text forms: `_texts` has each
# key's, and `_buckets` the positions of the keys whose text forms hash to
# each bucket. There are more buckets than keys, or none while it is empty.
struct Map[K: Eq, V]
    _order: [K]
    _stored: [V]
    _texts: [str]
    _buckets: [[i64]]
    get = (m: Map[K, V], key: K) -> V =>
        where
            key in m
        m._stored[m._position(key)]
    set = (mut m: Map[K, V], key: K, value: V) -> () =>
        let i = m._position(key)
        if i >= 0 then
            m._stored[i] = value
        else
            m._order += [key]
            m._stored += [value]
            m._texts += ["{{key}}"]
            if len(m._order) > len(m._buckets) then
                mut m._rehash()
            else
                m._buckets[m._bucket("{{key}}")] += [len(m._order) - 1]
    contains = (m: Map[K, V], key: K) -> bool => m._position(key) >= 0
    len = (m: Map[K, V]) -> i64 => len(m._order)
    iter = (m: Map[K, V]) -> [K] => m._order
    keys = (m: Map[K, V]) -> [K] => m._order
    values = (m: Map[K, V]) -> [V] => m._stored
    items = (m: Map[K, V]) -> [(K, V)] =>
        let mut pairs: [(K, V)] = []
        for i in 0..len(m._order)
            pairs += [(m._order[i], m._stored[i])]
        pairs
    lookup = (m: Map[K, V], key: K) -> Optional[V] =>
        let i = m._position(key)
        if i >= 0 then Some(m._stored[i]) else None
    remove = (mut m: Map[K, V], key: K) -> Optional[V] =>
        let i = m._position(key)
        if i < 0 then return None
        let value = m._stored[i]
        let n = len(m._order)
        m._order = m._order[0..i] + m._order[i + 1..n]
        m._stored = m._stored[0..i] + m._stored[i + 1..n]
        m._texts = m._texts[0..i] + m._texts[i + 1..n]
        mut m._rehash()
        Some(value)
    # Where the key is in `_order`, or -1.
    _position = (m: Map[K, V], key: K) -> i64 =>
        if len(m._buckets) == 0 then return -1
        let text = "{{key}}"
        for i in m._buckets[m._bucket(text)]
            if m._texts[i] == text then return i
        -1
    _bucket = (m: Map[K, V], text: str) -> i64 => hash(text) % len(m._buckets)
    # Puts every key in a bucket again, with twice as many buckets as keys (and a few more).
    _rehash = (mut m: Map[K, V]) -> () =>
        let mut buckets: [[i64]] = []
        for _ in 0..2 * len(m._order) + 8
            buckets += [[]]
        m._buckets = buckets
        for i in 0..len(m._texts)
            m._buckets[m._bucket(m._texts[i])] += [i]

let new_map[K: Eq, V] = () -> Map[K, V] => Map([], [], [], [])
