# Maps from keys to values. Part of the prelude: every module sees these names.

# A map from keys to values, which keeps its keys in the order they were
# first set. `_hashes` has each key's hash, and `_buckets` the positions of
# the keys whose hashes fall in each bucket. There are more buckets than
# keys, or none while it is empty.
struct Map[K: Eq, V]
    _order: [K]
    _stored: [V]
    _hashes: [i64]
    _buckets: [[i64]]
    get = (m: Map[K, V], key: K) -> V =>
        where
            key in m
        m._stored[m._position(key)]
    set = (mut m: Map[K, V], key: K, value: V) -> () =>
        let h = hash(key)
        let i = m._find(key, h)
        if i >= 0 then
            m._stored[i] = value
        else
            m._order += [key]
            m._stored += [value]
            m._hashes += [h]
            if len(m._order) > len(m._buckets) then
                mut m._rehash()
            else
                m._buckets[m._bucket(h)] += [len(m._order) - 1]
    contains = (m: Map[K, V], key: K) -> bool => m._position(key) >= 0
    len = (m: Map[K, V]) -> i64 => len(m._order)
    iter = (m: Map[K, V]) -> [K] => m._order
    keys = (m: Map[K, V]) -> [K] => m._order
    values = (m: Map[K, V]) -> [V] => m._stored
    items = (m: Map[K, V]) -> [(K, V)] =>
        let mut pairs: [(K, V)] = []
        for i in 0..len(m._order)
            pairs += [(m._order[i], m._stored[i])]
        pairs
    lookup = (m: Map[K, V], key: K) -> Optional[V] =>
        let i = m._position(key)
        if i >= 0 then Some(m._stored[i]) else None
    # The value of a key, or `default` if it has none.
    get_or = (m: Map[K, V], key: K, default: V) -> V =>
        let i = m._position(key)
        if i >= 0 then m._stored[i] else default
    remove = (mut m: Map[K, V], key: K) -> Optional[V] =>
        let i = m._position(key)
        if i < 0 then return None
        let value = m._stored[i]
        let n = len(m._order)
        m._order = m._order[0..i] + m._order[i + 1..n]
        m._stored = m._stored[0..i] + m._stored[i + 1..n]
        m._hashes = m._hashes[0..i] + m._hashes[i + 1..n]
        mut m._rehash()
        Some(value)
    # Where the key is in `_order`, or -1.
    _position = (m: Map[K, V], key: K) -> i64 => m._find(key, hash(key))
    _find = (m: Map[K, V], key: K, h: i64) -> i64 =>
        if len(m._buckets) == 0 then return -1
        for i in m._buckets[m._bucket(h)]
            if m._hashes[i] == h and m._order[i] == key then return i
        -1
    _bucket = (m: Map[K, V], h: i64) -> i64 => h % len(m._buckets)
    # Puts every key in a bucket again, with twice as many buckets as keys (and a few more).
    _rehash = (mut m: Map[K, V]) -> () =>
        let mut buckets: [[i64]] = []
        for _ in 0..2 * len(m._order) + 8
            buckets += [[]]
        m._buckets = buckets
        for i in 0..len(m._hashes)
            m._buckets[m._bucket(m._hashes[i])] += [i]

let new_map[K: Eq, V] = () -> Map[K, V] => Map([], [], [], [])

# A map of the pairs' keys to their values; a later pair replaces an earlier one's value.
let map_of[K: Eq, V] = (pairs: [(K, V)]) -> Map[K, V] =>
    let mut result = new_map()
    for (key, value) in pairs
        result[key] = value
    result

# The items of xs by their keys, each key's in the order they come, the keys
# in the order they first come.
let group_by[T, K: Eq] = (xs: [T], key: (T) -> K) -> Map[K, [T]] =>
    # Each key's group is found by its position, so items are added to the groups in place.
    let mut positions: Map[K, i64] = new_map()
    let mut groups: [[T]] = []
    for x in xs
        let k = key(x)
        let i = positions.get_or(k, len(groups))
        if i == len(groups) then
            positions[k] = i
            groups += [[]]
        groups[i] += [x]
    let mut result: Map[K, [T]] = new_map()
    for k in positions
        result[k] = groups[positions[k]]
    result

# How many times each item comes in xs, the items in the order they first come.
let counts[T: Eq] = (xs: [T]) -> Map[T, i64] =>
    let mut result: Map[T, i64] = new_map()
    for x in xs
        result[x] = result.get_or(x, 0) + 1
    result
