# Functions on lists. Part of the prelude: every module sees these names.
import iters


let reverse[T] = (xs: [T]) -> [T] =>
    let mut result: [T] = []
    let mut i = len(xs)
    while i > 0
        i -= 1
        result += [xs[i]]
    result

# A merge sort, which is stable and compares items with `<` only: runs of
# 1, 2, 4, ... items are merged in pairs, left to right.
let sort[T: Ord] = (xs: [T]) -> [T] =>
    let n = len(xs)
    let mut items = xs
    let mut width = 1
    while width < n
        let mut merged: [T] = []
        let mut start = 0
        while start < n
            let middle = if start + width < n then start + width else n
            let stop = if middle + width < n then middle + width else n
            let mut i = start
            let mut j = middle
            while i < middle and j < stop
                if items[j] < items[i] then
                    merged += [items[j]]
                    j += 1
                else
                    merged += [items[i]]
                    i += 1
            merged += items[i..middle]
            merged += items[j..stop]
            start = stop
        items = merged
        width *= 2
    items

# The same merge sort, comparing the keys of the items, each found once:
# it sorts the items' positions, then picks the items in that order.
let sort_by[T, K: Ord] = (xs: [T], key: (T) -> K) -> [T] =>
    let n = len(xs)
    let mut keys: [K] = []
    let mut order: [i64] = []
    for i in 0..n
        keys += [key(xs[i])]
        order += [i]
    let mut width = 1
    while width < n
        let mut merged: [i64] = []
        let mut start = 0
        while start < n
            let middle = if start + width < n then start + width else n
            let stop = if middle + width < n then middle + width else n
            let mut i = start
            let mut j = middle
            while i < middle and j < stop
                if keys[order[j]] < keys[order[i]] then
                    merged += [order[j]]
                    j += 1
                else
                    merged += [order[i]]
                    i += 1
            merged += order[i..middle]
            merged += order[j..stop]
            start = stop
        order = merged
        width *= 2
    let mut result: [T] = []
    for i in order
        result += [xs[i]]
    result

# The items added up, starting from T's zero: 0, "", [] or a type's own ZERO.
let sum[T: Add + Zero] = (xs: Iter[T]) -> T =>
    let mut total = T.ZERO
    for x in xs
        total += x
    total

let any[T] = (xs: [T], test: (T) -> bool) -> bool =>
    for x in xs
        if test(x) then return true
    false

let all[T] = (xs: [T], test: (T) -> bool) -> bool =>
    for x in xs
        if not test(x) then return false
    true

# f of the start and the first item, then of that and the second item, and so on.
let fold[T, A] = (xs: [T], start: A, f: (A, T) -> A) -> A =>
    let mut result = start
    for x in xs
        result = f(result, x)
    result

# The items of each list, one list after another.
let flatten[T] = (xss: [[T]]) -> [T] =>
    let mut result: [T] = []
    for xs in xss
        result += xs
    result

# The items of the lists that f gives for each item, in order.
let flat_map[T, U] = (xs: [T], f: (T) -> [U]) -> [U] =>
    let mut result: [U] = []
    for x in xs
        result += f(x)
    result

# Where the first item for which `test` is true is, if any.
let position[T] = (xs: [T], test: (T) -> bool) -> Optional[i64] =>
    for i in 0..len(xs)
        if test(xs[i]) then return Some(i)
    None

# The first and last items, if there are any.
let first[T] = (xs: [T]) -> Optional[T] => if len(xs) > 0 then Some(xs[0]) else None

let last[T] = (xs: [T]) -> Optional[T] => if len(xs) > 0 then Some(xs[len(xs) - 1]) else None

# Where the first item equal to x is, if any.
let index_of[T: Eq] = (xs: [T], x: T) -> Optional[i64] =>
    for i in 0..len(xs)
        if xs[i] == x then return Some(i)
    None

# The items of xs in lists of n (the last may have fewer).
let chunks[T] = (xs: [T], n: i64) -> [[T]] =>
    where
        n > 0
    let mut result: [[T]] = []
    let mut start = 0
    while start < len(xs)
        let stop = min(start + n, len(xs))
        result += [xs[start..stop]]
        start = stop
    result

# The smallest and largest items, by `<`, if there are any; the first of equal ones.
let min_of[T: Ord] = (xs: [T]) -> Optional[T] =>
    if len(xs) == 0 then return None
    let mut best = xs[0]
    for x in xs
        if x < best then best = x
    Some(best)

let max_of[T: Ord] = (xs: [T]) -> Optional[T] =>
    if len(xs) == 0 then return None
    let mut best = xs[0]
    for x in xs
        if best < x then best = x
    Some(best)

# The items with the smallest and largest keys, by `<`, if there are any; the
# first of equal ones. `key` is called once per item, in order.
let min_by[T, K: Ord] = (xs: [T], key: (T) -> K) -> Optional[T] =>
    if len(xs) == 0 then return None
    let mut best = 0
    let mut best_key = key(xs[0])
    for i in 1..len(xs)
        let k = key(xs[i])
        if k < best_key then
            best = i
            best_key = k
    Some(xs[best])

let max_by[T, K: Ord] = (xs: [T], key: (T) -> K) -> Optional[T] =>
    if len(xs) == 0 then return None
    let mut best = 0
    let mut best_key = key(xs[0])
    for i in 1..len(xs)
        let k = key(xs[i])
        if best_key < k then
            best = i
            best_key = k
    Some(xs[best])

# map, filter, zip and enumerate take anything a loop can go through (a list,
# str, range, generator, ...: docs/grammar.md §9, "Iter parameters") and give
# lists. iters has lazy ones, which give generators: iters.map(xs, f).

# f of each item, called in order.
let map[T, U] = (xs: Iter[T], f: (T) -> U) -> [U] =>
    let mut result: [U] = []
    for x in xs
        result += [f(x)]
    result

# The items for which `keep` is true, called in order.
let filter[T] = (xs: Iter[T], keep: (T) -> bool) -> [T] =>
    let mut result: [T] = []
    for x in xs
        if keep(x) then result += [x]
    result

# Pairs of the items of a and b, as many as the shorter one has.
let zip[T, U] = (a: Iter[T], b: Iter[U]) -> [(T, U)] =>
    let mut pairs: [(T, U)] = []
    let mut others = iters.each(b)
    for x in a
        match next(mut others)
            case Some(y) => pairs += [(x, y)]
            case None => break
    pairs

# Each item with its position: [(0, first), (1, second), ...].
let enumerate[T] = (xs: Iter[T]) -> [(i64, T)] =>
    let mut pairs: [(i64, T)] = []
    let mut i = 0
    for x in xs
        pairs += [(i, x)]
        i += 1
    pairs

# The items for which `test` is true, and those for which it is false, each in order.
let partition[T] = (xs: [T], test: (T) -> bool) -> ([T], [T]) =>
    let mut yes: [T] = []
    let mut no: [T] = []
    for x in xs
        if test(x) then yes += [x] else no += [x]
    (yes, no)

let range = (start: i64, stop: i64, step: i64) -> [i64] =>
    where
        step != 0
    let mut numbers: [i64] = []
    let mut n = start
    while (step > 0 and n < stop) or (step < 0 and n > stop)
        numbers += [n]
        n += step
    numbers
