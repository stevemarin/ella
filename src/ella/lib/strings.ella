# Functions on strings, beyond the library's (split, trim, find, ...). Part of
# the prelude: every module sees these names.

# The characters `trim` removes: space, \t, \n, \r, \v and \f.
let _whitespace = " \t\n\r\x0B\x0C"

# s, n times over: nothing if n is 0 or less.
let repeat = (s: str, n: i64) -> str =>
    let mut result = ""
    for _ in 0..n
        result += s
    result

# The lines of s, without their line breaks (\n or \r\n). A line break at the
# end doesn't start another line: "a\nb\n" has two lines, and "" has none.
let lines = (s: str) -> [str] =>
    let parts = split(s, "\n")
    let n = len(parts)
    let mut result: [str] = []
    for i in 0..n
        let part = parts[i]
        if i < n - 1 and ends_with(part, "\r") then
            result += [part[0..len(part) - 1]]
        else if i < n - 1 or part != "" then
            result += [part]
    result

# The words of s: its parts between runs of whitespace (what `trim` removes).
let words = (s: str) -> [str] =>
    let mut result: [str] = []
    let mut start = -1  # where the current word starts, or -1 between words
    for i in 0..len(s)
        if s[i] in _whitespace then
            if start >= 0 then
                result += [s[start..i]]
                start = -1
        else if start < 0 then
            start = i
    if start >= 0 then result += [s[start..len(s)]]
    result

# s without whitespace at its start, or at its end.
let trim_start = (s: str) -> str =>
    let mut i = 0
    while i < len(s) and s[i] in _whitespace
        i += 1
    s[i..len(s)]

let trim_end = (s: str) -> str =>
    let mut i = len(s)
    while i > 0 and s[i - 1] in _whitespace
        i -= 1
    s[0..i]

# s without `prefix` at its start (or `suffix` at its end), if it has it there.
let strip_prefix = (s: str, prefix: str) -> Optional[str] =>
    if starts_with(s, prefix) then Some(s[len(prefix)..len(s)]) else None

let strip_suffix = (s: str, suffix: str) -> Optional[str] =>
    if ends_with(s, suffix) then Some(s[0..len(s) - len(suffix)]) else None

# The parts of s before and after the first `sep`, if it has one.
let split_once = (s: str, sep: str) -> Optional[(str, str)] =>
    where
        sep != ""
    match find(s, sep)
        case Some(i) => Some((s[0..i], s[i + len(sep)..len(s)]))
        case None => None

# How many times `part` appears in s, left to right, not overlapping.
let count_of = (s: str, part: str) -> i64 =>
    where
        part != ""
    len(split(s, part)) - 1

# Whether s has at least one character, and each is an ASCII digit, an ASCII
# letter, or whitespace.
let is_digit = (s: str) -> bool => s != "" and all(chars(s), (c) => "0" <= c <= "9")

let is_alpha = (s: str) -> bool => s != "" and all(chars(s), (c) => "a" <= c <= "z" or "A" <= c <= "Z")

let is_space = (s: str) -> bool => s != "" and all(chars(s), (c) => c in _whitespace)
