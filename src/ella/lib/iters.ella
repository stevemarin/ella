# Lazy functions on anything a loop can go through: lists, strings, ranges,
# arrays, generators and iterators (docs/grammar.md §10). Part of the
# prelude. Each gives a generator, which asks for items only as its own are
# asked for; `collect` makes a list of its items.
#
# Each takes what it is given: a generator passed to one must be a new
# value, or a variable given away at its last use (docs/grammar.md §9).

# The items of xs, one at a time, as a generator.
let each[T] = (xs: Iter[T]) -> Gen[T] =>
    for x in xs
        yield x

# start, start + step, start + 2 * step, ... without end.
let count[T: Num] = (start: T, step: T) -> Gen[T] =>
    loop
        yield start
        start += step

# f of each item.
let map[T, U] = (xs: Iter[T], f: (T) -> U) -> Gen[U] =>
    for x in xs
        yield f(x)

# The items for which `keep` is true.
let filter[T] = (xs: Iter[T], keep: (T) -> bool) -> Gen[T] =>
    for x in xs
        if keep(x) then yield x

# The first n items (fewer if there aren't as many), asking for no more.
let take[T] = (xs: Iter[T], n: i64) -> Gen[T] =>
    if n <= 0 then return
    for x in xs
        yield x
        n -= 1
        if n == 0 then return

# The items after the first n.
let skip[T] = (xs: Iter[T], n: i64) -> Gen[T] =>
    for x in xs
        if n > 0 then n -= 1 else yield x

# The items up to the first one for which `keep` is false.
let take_while[T] = (xs: Iter[T], keep: (T) -> bool) -> Gen[T] =>
    for x in xs
        if not keep(x) then return
        yield x

# The items of a, then those of b.
let chain[T] = (a: Iter[T], b: Iter[T]) -> Gen[T] =>
    for x in a
        yield x
    for x in b
        yield x

# Each item with its position: (0, first), (1, second), ...
let enumerate[T] = (xs: Iter[T]) -> Gen[(i64, T)] =>
    let mut i = 0
    for x in xs
        yield (i, x)
        i += 1

# Pairs of the items of a and b, as many as the shorter one has.
let zip[T, U] = (a: Iter[T], b: Iter[U]) -> Gen[(T, U)] =>
    let mut others = each(b)
    for x in a
        match next(mut others)
            case Some(y) => yield (x, y)
            case None => return

# The running results of f: start, f(start, first), f(f(start, first), second), ...
let scan[T, A] = (xs: Iter[T], start: A, f: (A, T) -> A) -> Gen[A] =>
    yield start
    for x in xs
        start = f(start, x)
        yield start

# All the items, in a list.
let collect[T] = (xs: Iter[T]) -> [T] =>
    let mut items: [T] = []
    for x in xs
        items += [x]
    items

let sum[T: Add + Zero] = (xs: Iter[T]) -> T =>
    let mut total = T.ZERO
    for x in xs
        total += x
    total
